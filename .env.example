# Application
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ofertapronta

# AI Image Generation & Art Direction (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
# Estágio 1: Diretor de Arte / Planejador de Prompt
GEMINI_PROMPT_MODEL="gemini-3.8-flash"
# Estágio 2: Renderizador Multimodal de Imagem (ex: "gemini-nano-banana-2.1" ou "gemini-3-pro-image")
GEMINI_IMAGE_MODEL="gemini-nano-banana-2.1"

# Public Environment Variables (VITE_PUBLIC_*)
VITE_PUBLIC_APP_NAME="OfertaPronta"
VITE_PUBLIC_APP_URL="http://localhost:3000"

# Token obtido em Configurações > Integrações no painel da Pushin Pay
PUSHIN_PAY_TOKEN="seu_token_bearer_aqui"
# URL pública que a Pushin Pay deve acionar automaticamente a cada Pix gerado
PUSHIN_PAY_WEBHOOK_URL="https://ofertapronta.luis-carvalho.online/api/webhooks/pix"
# (Opcional) Chave secreta de proteção caso ative 'Usar Authorization' no Pushin Pay
# PUSHIN_PAY_WEBHOOK_SECRET="seu_token_secreto_aqui"

# (Desenvolvimento) Simulação de Pagamento Pix sem cobrança real e sem PUSHIN_PAY_TOKEN
# Defina como true no .env.local para testar o fluxo completo em localhost
DEV_BYPASS_PAYMENT=true

# Limites de Prévia Grátis (Free Preview Limits)
FREE_PREVIEW_SECRET="gere_um_segredo_aleatorio_com_pelo_menos_32_caracteres"
# FREE_PREVIEW_SECRET_PREVIOUS="segredo_anterior_para_rotacao_suave"
FREE_PREVIEW_DAILY_BUDGET=300
TRUSTED_PROXY=false
